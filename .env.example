# Runtime
NODE_ENV=development
WEB_BASE_URL=http://localhost:3000

# PostgreSQL
# Use Neon's pooled hostname for application traffic in Vercel.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backbeatpager
# Use Neon's direct hostname only for Prisma CLI migrations.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/backbeatpager
# Optional override. Auto-detected as "neon" for *.neon.tech and "pg" otherwise.
DATABASE_DRIVER=pg

# Console login (email + shared password — no Google required)
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_LOGIN_PASSWORD=replace-with-a-shared-console-password
# Allow either a domain, an explicit email list, or both.
AUTH_ALLOWED_DOMAIN=example.com
AUTH_ALLOWED_EMAILS=
# Local/E2E only; ignored in production.
AUTH_TEST_USER_EMAIL=

# Slack HTTP app
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_ACTION_SECRET=replace-with-at-least-32-random-bytes
SLACK_REQUIRED=false
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Resend (optional email delivery)
RESEND_API_KEY=
EMAIL_FROM=Backbeat Pager <pager@example.com>

# Vercel Workflow and reconciliation
CRON_SECRET=replace-with-a-random-secret
WORKFLOW_INTERNAL_SECRET=replace-with-a-different-random-secret

# Optional demo mappings used by pnpm db:seed
DEMO_ALICE_SLACK_USER_ID=
DEMO_BOB_SLACK_USER_ID=
DEMO_PAYMENTS_SLACK_CHANNEL_ID=
